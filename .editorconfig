# Editor defaults for this repository.
#
# Java follows the Ghidra coding standard, which uses tabs; the rest of the tree
# uses spaces. Mixing them is the most common source of noisy diffs here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
max_line_length = 100

[*.{gradle,properties}]
indent_style = space
indent_size = 4

[*.{py,md,yml,yaml,json}]
indent_style = space
indent_size = 2

# cmd.exe and PowerShell expect CRLF in these.
[*.{bat,cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{jar,zip,png,ico,exe,dll}]
insert_final_newline = false
trim_trailing_whitespace = false
